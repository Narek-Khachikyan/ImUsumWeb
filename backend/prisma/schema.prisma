generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                  @id @default(autoincrement())
  email                 String               @unique(map: "ix_users_email") @db.VarChar(255)
  hashed_password       String               @db.VarChar(255)
  first_name            String               @db.VarChar(100)
  last_name             String               @db.VarChar(100)
  role                  UserRole
  is_active             Boolean              @default(true)
  is_verified           Boolean              @default(false)
  token_version         Int                  @default(0)
  avatar_url            String?              @db.VarChar(500)
  phone                 String?              @db.VarChar(20)
  school_id             Int?
  created_at            DateTime             @default(now()) @db.Timestamp(6)
  updated_at            DateTime             @updatedAt @db.Timestamp(6)
  chat_channel_reads    ChatChannelRead[]
  chat_messages_sent    ChatMessage[]        @relation("ChatMessageSender")
  attendance_overrides  AttendanceOverride[] @relation("AttendanceOverrideAuthor")
  ai_workflow_runs      AiWorkflowRun[]      @relation("AiWorkflowRunAuthor")
  assignment_groups_created AssignmentGroup[] @relation("AssignmentGroupCreator")
  created_jobs          JobPosting[]         @relation("JobPostingCreator")
  job_eligibility_overrides JobEligibilityOverride[] @relation("JobEligibilityOverrideAuthor")
  password_reset_tokens PasswordResetToken[]
  uploaded_materials    LearningMaterial[]   @relation("LearningMaterialUploader")
  student_profile       StudentProfile?
  teacher_profile       TeacherProfile?
  school                School?              @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_users_id")
  @@map("users")
}

model School {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  address    String?  @db.VarChar(500)
  latitude   Float?
  longitude  Float?
  phone      String?  @db.VarChar(20)
  created_at DateTime @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  chat_channels ChatChannel[]
  classes    Class[]
  users      User[]

  @@index([id], map: "ix_schools_id")
  @@map("schools")
}

model Class {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  grade_level Int
  school_id   Int
  created_at  DateTime         @db.Timestamp(6)
  updated_at  DateTime         @updatedAt @db.Timestamp(6)
  assignments Assignment[]
  assignment_groups AssignmentGroup[]
  chat_channels ChatChannel[]
  learning_materials LearningMaterial[]
  school      School           @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedules   Schedule[]
  students    StudentProfile[]
  tests       Test[]

  @@index([id], map: "ix_classes_id")
  @@map("classes")
}

model StudentProfile {
  id                     Int                    @id @default(autoincrement())
  user_id                Int                    @unique
  class_id               Int?
  student_id_number      String?                @unique @db.VarChar(50)
  gpa                    Float?
  bonus_points           Int?
  created_at             DateTime               @default(now()) @db.Timestamp(6)
  updated_at             DateTime               @updatedAt @db.Timestamp(6)
  assignment_submissions AssignmentSubmission[]
  assignment_group_memberships AssignmentGroupMember[]
  assignment_targets     AssignmentTargetStudent[]
  attendance_records     AttendanceRecord[]
  grades                 Grade[]
  job_applications       JobApplication[]
  job_eligibility_override JobEligibilityOverride?
  purchases              Purchase[]
  test_attempts          TestAttempt[]
  class_                 Class?                 @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_profiles_id")
  @@map("student_profiles")
}

model TeacherProfile {
  id          Int              @id @default(autoincrement())
  user_id     Int              @unique
  employee_id String?          @unique @db.VarChar(50)
  department  String?          @db.VarChar(100)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  updated_at  DateTime         @updatedAt @db.Timestamp(6)
  assignments Assignment[]
  grades      Grade[]
  schedules   Schedule[]
  tests       Test[]
  user        User             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects    TeacherSubject[]

  @@index([id], map: "ix_teacher_profiles_id")
  @@map("teacher_profiles")
}

model Subject {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  code        String           @unique @db.VarChar(20)
  description String?
  created_at  DateTime         @db.Timestamp(6)
  updated_at  DateTime         @updatedAt @db.Timestamp(6)
  assignments Assignment[]
  grades      Grade[]
  learning_materials LearningMaterial[]
  schedules   Schedule[]
  tests       Test[]
  teachers    TeacherSubject[]

  @@index([id], map: "ix_subjects_id")
  @@map("subjects")
}

model TeacherSubject {
  teacher_id Int
  subject_id Int
  subject    Subject        @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher    TeacherProfile @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([teacher_id, subject_id])
  @@map("teacher_subjects")
}

model Schedule {
  id             Int            @id @default(autoincrement())
  class_id       Int
  subject_id     Int
  teacher_id     Int
  day_of_week    DayOfWeek
  start_time     DateTime       @db.Time(6)
  end_time       DateTime       @db.Time(6)
  room           String?        @db.VarChar(50)
  effective_from DateTime       @db.Date
  effective_to   DateTime?      @db.Date
  created_at     DateTime       @db.Timestamp(6)
  updated_at     DateTime       @updatedAt @db.Timestamp(6)
  attendance_records AttendanceRecord[]
  class_         Class          @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject        Subject        @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher        TeacherProfile @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_schedules_id")
  @@map("schedules")
}

model Assignment {
  id              Int                    @id @default(autoincrement())
  title           String                 @db.VarChar(255)
  description     String?
  assignment_type AssignmentType?
  target_scope    AssignmentTargetScope      @default(CLASS)
  subject_id      Int
  class_id        Int
  teacher_id      Int
  due_date        DateTime               @db.Timestamp(6)
  max_points      Int?
  is_published    Boolean?
  created_at      DateTime               @db.Timestamp(6)
  updated_at      DateTime               @updatedAt @db.Timestamp(6)
  submissions     AssignmentSubmission[]
  target_groups   AssignmentTargetGroup[]
  target_students AssignmentTargetStudent[]
  classes         Class                  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject                @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher         TeacherProfile         @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_assignments_id")
  @@map("assignments")
}

model AssignmentSubmission {
  id            Int            @id @default(autoincrement())
  assignment_id Int
  student_id    Int
  content       String?
  file_url      String?        @db.VarChar(500)
  submitted_at  DateTime?      @db.Timestamp(6)
  points_earned Int?
  feedback      String?
  is_graded     Boolean?
  created_at    DateTime       @db.Timestamp(6)
  updated_at    DateTime       @updatedAt @db.Timestamp(6)
  assignment    Assignment     @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_assignment_submissions_id")
  @@unique([assignment_id, student_id], map: "uq_assignment_submission_assignment_student")
  @@map("assignment_submissions")
}

model Grade {
  id           Int            @id @default(autoincrement())
  student_id   Int
  subject_id   Int
  teacher_id   Int
  grade_value  Float
  max_value    Float?
  grade_type   String         @db.VarChar(50)
  reference_id Int?
  date         DateTime       @db.Date
  comment      String?        @db.VarChar(500)
  created_at   DateTime       @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  student      StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject      Subject        @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      TeacherProfile @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_grades_id")
  @@map("grades")
}

model Test {
  id           Int           @id @default(autoincrement())
  title        String        @db.VarChar(255)
  description  String?
  subject_id   Int
  class_id     Int
  teacher_id   Int
  due_date     DateTime      @db.Timestamp(6)
  is_published Boolean       @default(false)
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  updated_at   DateTime      @updatedAt @db.Timestamp(6)
  attempts     TestAttempt[]
  class_       Class         @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions    TestQuestion[]
  subject      Subject       @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      TeacherProfile @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_tests_id")
  @@index([class_id], map: "ix_tests_class_id")
  @@index([teacher_id], map: "ix_tests_teacher_id")
  @@index([subject_id], map: "ix_tests_subject_id")
  @@map("tests")
}

model TestQuestion {
  id            Int          @id @default(autoincrement())
  test_id       Int
  question_text String
  order_index   Int
  points        Int          @default(1)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @updatedAt @db.Timestamp(6)
  answers       TestAnswer[]
  options       TestOption[]
  test          Test         @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_test_questions_id")
  @@unique([test_id, order_index], map: "uq_test_questions_test_order")
  @@map("test_questions")
}

model TestOption {
  id          Int         @id @default(autoincrement())
  question_id Int
  option_text String
  order_index Int
  is_correct  Boolean
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime    @updatedAt @db.Timestamp(6)
  answers     TestAnswer[]
  question    TestQuestion @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_test_options_id")
  @@unique([question_id, order_index], map: "uq_test_options_question_order")
  @@map("test_options")
}

model TestAttempt {
  id           Int            @id @default(autoincrement())
  test_id      Int
  student_id   Int
  submitted_at DateTime       @default(now()) @db.Timestamp(6)
  score_points Int
  max_points   Int
  percentage   Float
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  answers      TestAnswer[]
  student      StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  test         Test           @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_test_attempts_id")
  @@unique([test_id, student_id], map: "uq_test_attempts_test_student")
  @@map("test_attempts")
}

model TestAnswer {
  id                 Int          @id @default(autoincrement())
  attempt_id         Int
  question_id        Int
  selected_option_id Int
  is_correct         Boolean
  awarded_points     Int
  created_at         DateTime     @default(now()) @db.Timestamp(6)
  updated_at         DateTime     @updatedAt @db.Timestamp(6)
  attempt            TestAttempt  @relation(fields: [attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question           TestQuestion @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selected_option    TestOption   @relation(fields: [selected_option_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_test_answers_id")
  @@unique([attempt_id, question_id], map: "uq_test_answers_attempt_question")
  @@map("test_answers")
}

model ChatChannel {
  id              Int             @id @default(autoincrement())
  key             String          @unique(map: "ix_chat_channels_key") @db.VarChar(120)
  type            ChatChannelType
  school_id       Int
  class_id        Int?
  title           String          @db.VarChar(255)
  last_message_id Int?
  last_message_at DateTime?       @db.Timestamp(6)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @updatedAt @db.Timestamp(6)
  class_          Class?          @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  last_message    ChatMessage?    @relation("ChatChannelLastMessage", fields: [last_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  school          School          @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        ChatMessage[]   @relation("ChatChannelMessages")
  reads           ChatChannelRead[]

  @@index([id], map: "ix_chat_channels_id")
  @@index([school_id], map: "ix_chat_channels_school_id")
  @@index([class_id], map: "ix_chat_channels_class_id")
  @@map("chat_channels")
}

model ChatMessage {
  id                Int               @id @default(autoincrement())
  channel_id        Int
  sender_user_id    Int
  body              String?
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  edited_at         DateTime?         @db.Timestamp(6)
  deleted_at        DateTime?         @db.Timestamp(6)
  updated_at        DateTime          @updatedAt @db.Timestamp(6)
  channel           ChatChannel       @relation("ChatChannelMessages", fields: [channel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender            User              @relation("ChatMessageSender", fields: [sender_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  last_for_channels ChatChannel[]     @relation("ChatChannelLastMessage")

  @@index([id], map: "ix_chat_messages_id")
  @@index([channel_id, id], map: "ix_chat_messages_channel_id_id")
  @@index([sender_user_id], map: "ix_chat_messages_sender_user_id")
  @@map("chat_messages")
}

model ChatChannelRead {
  user_id              Int
  channel_id           Int
  last_read_message_id Int?
  updated_at           DateTime    @updatedAt @db.Timestamp(6)
  channel              ChatChannel @relation(fields: [channel_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 User        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, channel_id])
  @@index([channel_id], map: "ix_chat_channel_reads_channel_id")
  @@map("chat_channel_reads")
}

model BlogPost {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  image      String?  @db.VarChar(500)
  letter     String
  date       DateTime @db.Date
  hot        Boolean?
  created_at DateTime @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  @@index([id], map: "ix_blog_posts_id")
  @@map("blog_posts")
}

model LearningMaterial {
  id                  Int                 @id @default(autoincrement())
  title               String              @db.VarChar(255)
  description         String?
  material_type       LearningMaterialType @default(BOOK)
  author              String?             @db.VarChar(255)
  file_url            String              @db.VarChar(500)
  thumbnail_url       String?             @db.VarChar(500)
  subject_id          Int?
  class_id            Int?
  is_published        Boolean             @default(true)
  uploaded_by_user_id Int
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @updatedAt @db.Timestamp(6)
  class_              Class?              @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject             Subject?            @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploaded_by_user    User                @relation("LearningMaterialUploader", fields: [uploaded_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_learning_materials_id")
  @@index([subject_id], map: "ix_learning_materials_subject_id")
  @@index([class_id], map: "ix_learning_materials_class_id")
  @@index([uploaded_by_user_id], map: "ix_learning_materials_uploaded_by_user_id")
  @@index([material_type], map: "ix_learning_materials_material_type")
  @@map("learning_materials")
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  image       String?  @db.VarChar(500)
  website     String?  @db.VarChar(500)
  description String?
  created_at  DateTime @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@index([id], map: "ix_partners_id")
  @@map("partners")
}

model Offer {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(255)
  description    String?
  price          Int
  image_url      String?    @db.VarChar(500)
  brand_name     String     @db.VarChar(255)
  category       String     @db.VarChar(50)
  stock_quantity Int?
  is_active      Boolean?
  created_at     DateTime   @db.Timestamp(6)
  updated_at     DateTime   @updatedAt @db.Timestamp(6)
  purchases      Purchase[]

  @@index([id], map: "ix_offers_id")
  @@map("offers")
}

model Purchase {
  id           Int            @id @default(autoincrement())
  student_id   Int
  offer_id     Int
  points_spent Int
  qr_code      String         @unique(map: "ix_purchases_qr_code") @db.VarChar(255)
  status       String         @db.VarChar(20)
  redeemed_at  DateTime?      @db.Timestamp(6)
  created_at   DateTime       @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  offer        Offer          @relation(fields: [offer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student      StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_purchases_id")
  @@index([offer_id], map: "ix_purchases_offer_id")
  @@index([student_id], map: "ix_purchases_student_id")
  @@map("purchases")
}

model AttendanceRecord {
  id              Int               @id @default(autoincrement())
  student_id      Int
  schedule_id     Int
  attendance_date DateTime          @db.Date
  checked_in_at   DateTime?         @db.Timestamp(6)
  status          AttendanceStatus
  source          AttendanceSource  @default(GEOLOCATION)
  latitude        Float?
  longitude       Float?
  accuracy_m      Float?
  distance_m      Float?
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @updatedAt @db.Timestamp(6)
  overrides       AttendanceOverride[]
  schedule        Schedule          @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         StudentProfile    @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, schedule_id, attendance_date], map: "uq_attendance_records_student_schedule_date")
  @@index([attendance_date], map: "ix_attendance_records_attendance_date")
  @@index([schedule_id], map: "ix_attendance_records_schedule_id")
  @@index([student_id], map: "ix_attendance_records_student_id")
  @@index([id], map: "ix_attendance_records_id")
  @@map("attendance_records")
}

model AttendanceOverride {
  id                   Int              @id @default(autoincrement())
  attendance_record_id Int
  changed_by_user_id   Int
  previous_status      AttendanceStatus
  new_status           AttendanceStatus
  reason               String?
  created_at           DateTime         @default(now()) @db.Timestamp(6)
  attendance_record    AttendanceRecord @relation(fields: [attendance_record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changed_by_user      User             @relation("AttendanceOverrideAuthor", fields: [changed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([attendance_record_id], map: "ix_attendance_overrides_attendance_record_id")
  @@index([changed_by_user_id], map: "ix_attendance_overrides_changed_by_user_id")
  @@index([id], map: "ix_attendance_overrides_id")
  @@map("attendance_overrides")
}

model AiWorkflowRun {
  id                 Int            @id @default(autoincrement())
  workflow_type      AiWorkflowType
  status             AiWorkflowStatus @default(DRAFT)
  input_json         Json
  output_json        Json
  error_message      String?
  created_by_user_id Int
  applied_at         DateTime?      @db.Timestamp(6)
  created_at         DateTime       @default(now()) @db.Timestamp(6)
  updated_at         DateTime       @updatedAt @db.Timestamp(6)
  created_by_user    User           @relation("AiWorkflowRunAuthor", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflow_type], map: "ix_ai_workflow_runs_workflow_type")
  @@index([status], map: "ix_ai_workflow_runs_status")
  @@index([created_by_user_id], map: "ix_ai_workflow_runs_created_by_user_id")
  @@index([id], map: "ix_ai_workflow_runs_id")
  @@map("ai_workflow_runs")
}

model JobPosting {
  id                 Int               @id @default(autoincrement())
  title              String            @db.VarChar(255)
  description        String
  company_name       String            @db.VarChar(255)
  contact_email      String?           @db.VarChar(255)
  external_url       String?           @db.VarChar(500)
  is_active          Boolean           @default(true)
  created_by_user_id Int
  created_at         DateTime          @default(now()) @db.Timestamp(6)
  updated_at         DateTime          @updatedAt @db.Timestamp(6)
  applications       JobApplication[]
  created_by_user    User              @relation("JobPostingCreator", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active], map: "ix_job_postings_is_active")
  @@index([created_by_user_id], map: "ix_job_postings_created_by_user_id")
  @@index([id], map: "ix_job_postings_id")
  @@map("job_postings")
}

model JobApplication {
  id            Int                  @id @default(autoincrement())
  job_posting_id Int
  student_id    Int
  status        JobApplicationStatus @default(PENDING)
  cover_letter  String?
  created_at    DateTime             @default(now()) @db.Timestamp(6)
  updated_at    DateTime             @updatedAt @db.Timestamp(6)
  job_posting   JobPosting           @relation(fields: [job_posting_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       StudentProfile       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([job_posting_id, student_id], map: "uq_job_applications_job_student")
  @@index([job_posting_id], map: "ix_job_applications_job_posting_id")
  @@index([student_id], map: "ix_job_applications_student_id")
  @@index([status], map: "ix_job_applications_status")
  @@index([id], map: "ix_job_applications_id")
  @@map("job_applications")
}

model JobEligibilityOverride {
  id              Int            @id @default(autoincrement())
  student_id      Int            @unique(map: "uq_job_eligibility_overrides_student_id")
  eligible        Boolean
  reason          String?
  set_by_user_id  Int
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @updatedAt @db.Timestamp(6)
  set_by_user     User           @relation("JobEligibilityOverrideAuthor", fields: [set_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([set_by_user_id], map: "ix_job_eligibility_overrides_set_by_user_id")
  @@index([id], map: "ix_job_eligibility_overrides_id")
  @@map("job_eligibility_overrides")
}

model AssignmentGroup {
  id                 Int                    @id @default(autoincrement())
  name               String                 @db.VarChar(255)
  class_id           Int
  created_by_user_id Int
  created_at         DateTime               @default(now()) @db.Timestamp(6)
  updated_at         DateTime               @updatedAt @db.Timestamp(6)
  members            AssignmentGroupMember[]
  targets            AssignmentTargetGroup[]
  class_             Class                  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user    User                   @relation("AssignmentGroupCreator", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, name], map: "uq_assignment_groups_class_name")
  @@index([class_id], map: "ix_assignment_groups_class_id")
  @@index([created_by_user_id], map: "ix_assignment_groups_created_by_user_id")
  @@index([id], map: "ix_assignment_groups_id")
  @@map("assignment_groups")
}

model AssignmentGroupMember {
  id          Int             @id @default(autoincrement())
  group_id    Int
  student_id  Int
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  group       AssignmentGroup @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student     StudentProfile  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, student_id], map: "uq_assignment_group_members_group_student")
  @@index([group_id], map: "ix_assignment_group_members_group_id")
  @@index([student_id], map: "ix_assignment_group_members_student_id")
  @@index([id], map: "ix_assignment_group_members_id")
  @@map("assignment_group_members")
}

model AssignmentTargetGroup {
  id            Int             @id @default(autoincrement())
  assignment_id Int
  group_id      Int
  assignment    Assignment      @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group         AssignmentGroup @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignment_id, group_id], map: "uq_assignment_target_groups_assignment_group")
  @@index([assignment_id], map: "ix_assignment_target_groups_assignment_id")
  @@index([group_id], map: "ix_assignment_target_groups_group_id")
  @@index([id], map: "ix_assignment_target_groups_id")
  @@map("assignment_target_groups")
}

model AssignmentTargetStudent {
  id            Int            @id @default(autoincrement())
  assignment_id Int
  student_id    Int
  assignment    Assignment     @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       StudentProfile @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignment_id, student_id], map: "uq_assignment_target_students_assignment_student")
  @@index([assignment_id], map: "ix_assignment_target_students_assignment_id")
  @@index([student_id], map: "ix_assignment_target_students_student_id")
  @@index([id], map: "ix_assignment_target_students_id")
  @@map("assignment_target_students")
}

model PasswordResetToken {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  token_hash           String    @unique(map: "ix_password_reset_tokens_token_hash") @db.VarChar(64)
  expires_at           DateTime  @db.Timestamp(6)
  used_at              DateTime? @db.Timestamp(6)
  requested_ip         String?   @db.VarChar(45)
  requested_user_agent String?   @db.VarChar(500)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @updatedAt @db.Timestamp(6)
  user                 User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "ix_password_reset_tokens_expires_at")
  @@index([id], map: "ix_password_reset_tokens_id")
  @@index([used_at], map: "ix_password_reset_tokens_used_at")
  @@index([user_id], map: "ix_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

